#!/usr/bin/env bash
# Build the Debug app ("Pane Dev", sh.saad.pane.dev) and launch it with its settings open.
#
# Usage: scripts/run
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
APP="$ROOT/build/DerivedData/Build/Products/Debug/Pane.app"

xcodegen generate --quiet --spec "$ROOT/project.yml"
xcodebuild -project "$ROOT/Pane.xcodeproj" -scheme Pane -configuration Debug \
  -destination 'platform=macOS' -derivedDataPath "$ROOT/build/DerivedData" -quiet build

# Only the Debug build: an installed release has a different bundle identifier.
osascript -e 'tell application id "sh.saad.pane.dev" to quit' >/dev/null 2>&1 || true
open "$APP" --args --settings
